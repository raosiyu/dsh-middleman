{
  "name": "dsh-whale-tail",
  "version": "0.1.0",
  "description": "主会话中台：盘问 → 收敛 → 人工批准 → 派发独立子会话（挂起等执行）→ turn/end 回传",
  "type": "module",
  "main": "lib/index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "USAGE.md",
    "LICENSE",
    "icon.svg"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.3",
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "orchestration"
  ],
  "license": "MIT"
}
